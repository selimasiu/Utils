#pln volcanno
markers_pln_gdt <- FindMarkers(Guy, ident.1 = "pLN_GdT")
markers_pln_gdt <- sc_annotate_de(markers_pln_gdt)
sc_volcano_plotly(markers_pln_gdt, "marker pln")
sc_volcano(markers_pln_gdt)+ theme_classic()
write.csv(markers_pln_gdt , "markers_plN.csv")
library(EnhancedVolcano)


tiff(filename = "marker_pln.tiff", width = 10, height = 20 , units = "in", res = 300)
EnhancedVolcano(markers_pln_gdt,
                lab = rownames(markers_pln_gdt),
                x = 'avg_log2FC',
                y = 'p_val_adj')

dev.off()

